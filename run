#!/usr/bin/env bash
# Контракт §2.1: ./run --catalog /absolute/path/catalog.json < request.json > response.json
# Один процесс = один запрос. stdout отдаёт ровно один JSON-объект, все логи идут в stderr.
set -euo pipefail

cd "$(dirname "$0")"

PYTHON_BIN="${PYTHON:-python3}"
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    PYTHON_BIN="python"
fi

exec "$PYTHON_BIN" -m app.main "$@"
