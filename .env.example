# Скопируйте в .env и подставьте ключ, выданный организатором.
# .env лежит в .gitignore: в репозитории ключа нет и быть не должно.
LLM_BASE_URL=https://sfedu-hackathon-ai-gateway.sfedu-hackathon-ai-gateway.workers.dev/v1
LLM_MODEL=google/gemma-4-31B-it
LLM_API_KEY=
LLM_USER_AGENT=team-02/1.0
TEAM_NAME=team-02
LLM_EXPIRES_AT=2026-11-22T16:00:00+00:00

# Необязательное: 1 = полностью офлайн-режим (модель не вызывается никогда).
# Полезно для тестов и нагрузочного стенда.
ASSISTANT_OFFLINE=0
